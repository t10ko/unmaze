@@ -0,0 +1,29 @@
+import { describe, expect, it, vi } from "vitest";
+import { PostgresIdempotencyStore } from "../services/idempotency/store";
+
+describe("PostgresIdempotencyStore", () => {
+  it("suppresses duplicate completed events", async () => {
+    const db = {
+      query: vi.fn().mockResolvedValueOnce({
+        rows: [{ status: "COMPLETED", lease_expires_at: new Date(Date.now() + 60_000) }],
+        inserted: false,
+      }),
+    };
+    const store = new PostgresIdempotencyStore(db as any);
+    const decision = await store.claimOrSkip("stripe", "evt_123");
+    expect(decision).toEqual({ action: "SKIP_ALREADY_PROCESSED" });
+  });
+
+  it("reclaims an expired lease after worker crash", async () => {
+    const db = {
+      query: vi.fn().mockResolvedValueOnce({
+        rows: [{ status: "CLAIMED", lease_expires_at: new Date(Date.now() + 60_000) }],
+        inserted: true,
+      }),
+    };
+    const store = new PostgresIdempotencyStore(db as any);
+    const decision = await store.claimOrSkip("stripe", "evt_stalled");
+    expect(decision).toEqual({ action: "PROCESS" });
+  });
+});
