diff --git a/services/idempotency/store.ts b/services/idempotency/store.ts
new file mode 100644
index 0000000..c7a319e
--- /dev/null
+++ b/services/idempotency/store.ts
@@ -0,0 +1,52 @@
+import type { ClaimDecision, IdempotencyOptions, IdempotencyStore } from "./types";
+
+export class PostgresIdempotencyStore implements IdempotencyStore {
+  private readonly leaseTtlMs: number;
+
+  constructor(
+    private readonly db: { query: (sql: string, params: unknown[]) => Promise<any> },
+    options: IdempotencyOptions = {},
+  ) {
+    this.leaseTtlMs = options.leaseTtlMs ?? 60_000;
+  }
+
+  async claimOrSkip(provider: string, eventId: string): Promise<ClaimDecision> {
+    const leaseUntil = new Date(Date.now() + this.leaseTtlMs).toISOString();
+    try {
+      const res = await this.db.query(
+        `INSERT INTO webhook_idempotency_keys (provider, event_id, status, lease_expires_at, updated_at)
+         VALUES ($1, $2, 'CLAIMED', $3, NOW())
+         ON CONFLICT (provider, event_id) DO UPDATE
+           SET status = 'CLAIMED', lease_expires_at = EXCLUDED.lease_expires_at, updated_at = NOW()
+           WHERE webhook_idempotency_keys.status = 'CLAIMED'
+             AND webhook_idempotency_keys.lease_expires_at < NOW()
+         RETURNING status`,
+        [provider, eventId, leaseUntil],
+      );
+      if (res.rows.length > 0) {
+        return { action: "PROCESS" };
+      }
+      return { action: "SKIP_IN_FLIGHT_OR_DONE" };
+    } catch {
+      // Fail-open so transient DB hiccups do not block webhook ingestion
+      return { action: "PROCESS" };
+    }
+  }
+
+  async markCompleted(provider: string, eventId: string): Promise<void> {
+    await this.db.query(
+      `UPDATE webhook_idempotency_keys
+       SET status = 'COMPLETED', updated_at = NOW()
+       WHERE provider = $1 AND event_id = $2`,
+      [provider, eventId],
+    );
+  }
+
+  async releaseClaim(provider: string, eventId: string): Promise<void> {
+    await this.db.query(
+      `DELETE FROM webhook_idempotency_keys
+       WHERE provider = $1 AND event_id = $2 AND status = 'CLAIMED'`,
+      [provider, eventId],
+    );
+  }
+}
diff --git a/services/idempotency/types.ts b/services/idempotency/types.ts
new file mode 100644
index 0000000..e19d04a
--- /dev/null
+++ b/services/idempotency/types.ts
@@ -0,0 +1,16 @@
+export type IdempotencyStatus = "CLAIMED" | "COMPLETED";
+
+export type ClaimDecision =
+  | { action: "PROCESS" }
+  | { action: "SKIP_ALREADY_PROCESSED" }
+  | { action: "SKIP_IN_FLIGHT_OR_DONE" };
+
+export interface IdempotencyOptions {
+  leaseTtlMs?: number;
+}
+
+export interface IdempotencyStore {
+  claimOrSkip(provider: string, eventId: string): Promise<ClaimDecision>;
+  markCompleted(provider: string, eventId: string): Promise<void>;
+  releaseClaim(provider: string, eventId: string): Promise<void>;
+}
